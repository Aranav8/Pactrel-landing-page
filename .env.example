# Waitlist Setup

# 1. Sign up for free at https://resend.com
# 2. Get your API key from the dashboard
RESEND_API_KEY=

# The email address that should receive the waitlist signups
WAITLIST_EMAIL_TO=

# Resend Audience that stores every waitlist signup (Audiences > copy the ID).
# Create two contact properties in Resend first: "plan" and "billing" (both text).
# In production, signups fail with an error if this is missing.
RESEND_AUDIENCE_ID=

# The email address that the automated replies should come from
# E.g., "Pactrel <hello@pactrel.com>" (Requires verified domain in Resend)
# Leave blank to use Resend's default testing sender
RESEND_FROM_EMAIL=

# Microsoft Clarity project ID (site analytics). Only loads after the visitor
# accepts the cookie banner. Leave blank to disable.
VITE_CLARITY_ID=
