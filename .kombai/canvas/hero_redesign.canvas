      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: #0B0C10;\n    color: white;\n    font-family: 'Inter', sans-serif;\n  }\n\n  .font-display {\n    font-family: 'Outfit', sans-serif;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n  }\n\n  .glow-radial {\n    background: radial-gradient(circle at center, rgba(167, 126, 126, 0.15) 0%, transparent 70%);\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0px); }\n    50% { transform: translateY(-10px); }\n  }\n\n  .animate-float {\n    animation: float 4s ease-in-out infinite;\n  }\n\n  .animate-float-delayed {\n    animation: float 4s ease-in-out infinite;\n    animation-delay: 2s;\n  }\n\n  .pulse-link {\n    animation: pulse-ring 2s cubic-bezier(0.455, 0.03, 0.515, 0.955) infinite;\n  }\n\n  @keyframes pulse-ring {\n    0% { transform: scale(0.8); opacity: 0.5; }\n    100% { transform: scale(1.3); opacity: 0; }\n  }\n</style>\n\n<section class=\"relative min-h-[900px] flex flex-col items-center justify-center overflow-hidden bg-[#0B0C10]\" data-kid=\"1\">\n  \n  <div class=\"absolute inset-0 glow-radial pointer-events-none\" data-kid=\"2\"></div>\n  <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-gradient-to-b from-[#A77E7E]/10 to-transparent blur-[120px] -z-10\" data-kid=\"3\"></div>\n\n  \n  <div class=\"relative z-10 max-w-5xl px-6 text-center pt-20\" data-kid=\"4\">\n    \n    <div class=\"inline-flex items-center px-4 py-1.5 rounded-full border border-white/10 bg-white/5 mb-8 backdrop-blur-sm\" data-kid=\"5\">\n      <span class=\"text-[12px] font-medium tracking-wide text-[#A77E7E] uppercase\" data-kid=\"6\">The 30-minute setup solution</span>\n    </div>\n\n    \n    <h1 class=\"text-5xl md:text-7xl font-display font-semibold text-white mb-6 leading-[1.1] tracking-tight\" data-kid=\"7\">\n      Stop losing hours to client <br data-kid=\"8\">\n      <span class=\"text-[#FAE6E1] italic\" data-kid=\"9\">onboarding chaos.</span>\n    </h1>\n\n    \n    <p class=\"text-lg md:text-xl text-[#8B8C8F] max-w-2xl mx-auto mb-10 leading-relaxed\" data-kid=\"10\">\n      Send one link. Your client signs the contract, pays the deposit, and submits their brief in minutes—without creating an account.\n    </p>\n\n    \n    <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4 mb-24\" data-kid=\"11\">\n      <button class=\"px-8 py-4 bg-[#FAE6E1] text-[#0B0C10] font-semibold rounded-xl hover:bg-white transition-all transform hover:scale-105\" data-kid=\"12\">\n        Claim my spot\n      </button>\n      <button class=\"px-8 py-4 border border-white/10 text-white font-medium rounded-xl hover:bg-white/5 transition-all\" data-kid=\"13\">\n        See how it works\n      </button>\n    </div>\n\n    \n    <div class=\"relative w-full h-[400px] flex items-center justify-center\" data-kid=\"14\">\n      \n      \n      <svg class=\"absolute inset-0 w-full h-full pointer-events-none\" viewBox=\"0 0 1000 400\" data-kid=\"15\">\n        <defs data-kid=\"16\">\n          <linearGradient id=\"lineGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\" data-kid=\"17\">\n            <stop offset=\"0%\" style=\"stop-color:rgba(167, 126, 126, 0)\" data-kid=\"18\"></stop>\n            <stop offset=\"50%\" style=\"stop-color:rgba(167, 126, 126, 0.4)\" data-kid=\"19\"></stop>\n            <stop offset=\"100%\" style=\"stop-color:rgba(167, 126, 126, 0)\" data-kid=\"20\"></stop>\n          </linearGradient>\n        </defs>\n        \n        <path d=\"M 250,150 Q 400,150 500,200\" fill=\"none\" stroke=\"url(#lineGrad)\" stroke-width=\"2\" stroke-dasharray=\"6,6\" data-kid=\"21\"></path>\n        \n        <path d=\"M 750,100 Q 600,100 500,200\" fill=\"none\" stroke=\"url(#lineGrad)\" stroke-width=\"2\" stroke-dasharray=\"6,6\" data-kid=\"22\"></path>\n        \n        <path d=\"M 750,300 Q 600,300 500,200\" fill=\"none\" stroke=\"url(#lineGrad)\" stroke-width=\"2\" stroke-dasharray=\"6,6\" data-kid=\"23\"></path>\n      </svg>\n\n      \n      <div class=\"relative z-20\" data-kid=\"24\">\n        <div class=\"absolute inset-0 rounded-full bg-[#FAE6E1]/20 blur-xl pulse-link\" data-kid=\"25\"></div>\n        <div class=\"w-16 h-16 rounded-full bg-[#FAE6E1] flex items-center justify-center text-[#0B0C10] shadow-[0_0_40px_rgba(250,230,225,0.4)]\" data-kid=\"26\">\n          <i class=\"ti ti-link text-3xl\" data-kid=\"27\"></i>\n        </div>\n        <div class=\"absolute -bottom-10 left-1/2 -translate-x-1/2 whitespace-nowrap\" data-kid=\"28\">\n          <span class=\"text-[11px] font-semibold uppercase tracking-[0.2em] text-[#FAE6E1]\" data-kid=\"29\">One Magic Link</span>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute left-[10%] top-[20%] glass-card p-5 rounded-2xl w-52 animate-float text-left\" data-kid=\"30\">\n        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"31\">\n          <div class=\"w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-400\" data-kid=\"32\">\n            <i class=\"ti ti-signature text-lg\" data-kid=\"33\"></i>\n          </div>\n          <span class=\"text-xs font-semibold text-white/90\" data-kid=\"34\">Review & Sign</span>\n        </div>\n        <div class=\"space-y-2 mb-4\" data-kid=\"35\">\n          <div class=\"h-1.5 w-full bg-white/5 rounded-full\" data-kid=\"36\"></div>\n          <div class=\"h-1.5 w-2/3 bg-white/5 rounded-full\" data-kid=\"37\"></div>\n        </div>\n        <div class=\"flex items-center justify-between\" data-kid=\"38\">\n          <span class=\"text-[10px] text-white/40 uppercase tracking-wider\" data-kid=\"39\">Service Agreement</span>\n          <i class=\"ti ti-square-check text-emerald-400\" data-kid=\"40\"></i>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute right-[10%] top-[0%] glass-card p-5 rounded-2xl w-48 animate-float-delayed text-left\" data-kid=\"41\">\n        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"42\">\n          <div class=\"w-8 h-8 rounded-lg bg-[#A77E7E]/10 flex items-center justify-center text-[#A77E7E]\" data-kid=\"43\">\n            <i class=\"ti ti-credit-card text-lg\" data-kid=\"44\"></i>\n          </div>\n          <span class=\"text-xs font-semibold text-white/90\" data-kid=\"45\">Pay Deposit</span>\n        </div>\n        <div class=\"mb-4\" data-kid=\"46\">\n          <span class=\"text-2xl font-display font-bold text-white\" data-kid=\"47\">$500.00</span>\n          <span class=\"text-[10px] text-white/40 ml-1\" data-kid=\"48\">USD</span>\n        </div>\n        <div class=\"flex items-center gap-2 px-2 py-1 rounded bg-white/5 border border-white/5 w-fit\" data-kid=\"49\">\n          <i class=\"ti ti-lock text-[10px] text-white/60\" data-kid=\"50\"></i>\n          <span class=\"text-[9px] text-white/60 font-medium uppercase\" data-kid=\"51\">Secure Payment</span>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute right-[12%] bottom-[10%] glass-card p-5 rounded-2xl w-52 animate-float text-left\" data-kid=\"52\">\n        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"53\">\n          <div class=\"w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center text-blue-400\" data-kid=\"54\">\n            <i class=\"ti ti-file-description text-lg\" data-kid=\"55\"></i>\n          </div>\n          <span class=\"text-xs font-semibold text-white/90\" data-kid=\"56\">Project Brief</span>\n        </div>\n        <div class=\"space-y-3\" data-kid=\"57\">\n          <div class=\"flex items-center gap-2\" data-kid=\"58\">\n            <div class=\"w-3 h-3 rounded border border-white/20 flex items-center justify-center\" data-kid=\"59\">\n              <div class=\"w-1.5 h-1.5 bg-blue-400 rounded-sm\" data-kid=\"60\"></div>\n            </div>\n            <div class=\"h-1 w-20 bg-white/10 rounded-full\" data-kid=\"61\"></div>\n          </div>\n          <div class=\"flex items-center gap-2\" data-kid=\"62\">\n            <div class=\"w-3 h-3 rounded border border-white/20\" data-kid=\"63\"></div>\n            <div class=\"h-1 w-24 bg-white/10 rounded-full\" data-kid=\"64\"></div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  \n  <div class=\"absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-[#0B0C10] to-transparent z-20\" data-kid=\"65\"></div>\n</section>",
