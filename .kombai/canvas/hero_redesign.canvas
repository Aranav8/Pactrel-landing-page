      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  @layer base {\n    body {\n      margin: 0;\n      background-color: #000000;\n      font-family: 'Inter', sans-serif;\n      color: #F3F4F6;\n    }\n  }\n\n  .font-space { font-family: 'Space Grotesk', sans-serif; }\n  \n  @keyframes pulse-dot {\n    0%, 100% { transform: scale(1); opacity: 1; }\n    50% { transform: scale(1.4); opacity: 0.6; }\n  }\n  .animate-pulse-dot {\n    animation: pulse-dot 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  }\n</style>\n\n<section class=\"relative min-h-[1200px] flex flex-col items-center overflow-hidden bg-black py-24 px-6\" data-kid=\"1\">\n  \n  <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-[#E27D60]/5 rounded-full blur-[120px] pointer-events-none\" data-kid=\"2\"></div>\n\n  \n  <div class=\"flex items-center gap-3 mb-10 group\" data-kid=\"3\">\n    <div class=\"w-2 h-2 bg-[#E27D60] rounded-full animate-pulse-dot shadow-[0_0_8px_#E27D60]\" data-kid=\"4\"></div>\n    <span class=\"font-space text-[12px] font-medium tracking-[0.3em] text-[#E8A87C] uppercase\" data-kid=\"5\">\n      THE DUBSADO THAT TAKES 30 MINUTES TO SET UP, NOT 2 WEEKS\n    </span>\n  </div>\n\n  \n  <h1 class=\"text-[72px] font-extrabold text-center leading-[1.1] tracking-tight max-w-5xl mb-8 text-[#F3F4F6]\" data-kid=\"6\">\n    Stop losing hours to client <br data-kid=\"7\">\n    <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[#E27D60] to-[#E8A87C]\" data-kid=\"8\">onboarding chaos.</span>\n  </h1>\n\n  \n  <p class=\"text-lg text-[#6B7280] text-center max-w-2xl mb-14 leading-relaxed font-medium\" data-kid=\"9\">\n    Send one link. Your client signs the contract, pays the deposit, and submits their brief - without creating an account. Setup takes 30 minutes, not two weeks.\n  </p>\n\n  \n  <div class=\"w-full max-w-[460px] bg-[#0A0A0A] border border-[#E27D60]/20 rounded-2xl p-8 shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative z-10\" data-kid=\"10\">\n    <div class=\"absolute inset-0 bg-gradient-to-b from-white/[0.03] to-transparent pointer-events-none rounded-2xl\" data-kid=\"11\"></div>\n    \n    <a href=\"#\" class=\"block w-full py-4 px-6 bg-[#E27D60] hover:bg-[#D16B4F] text-white font-bold text-center rounded-xl transition-all duration-300 shadow-[0_4px_20px_rgba(226,125,96,0.3)] hover:shadow-[0_6px_25px_rgba(226,125,96,0.4)] hover:-translate-y-0.5 active:translate-y-0\" data-kid=\"12\">\n      Claim my spot\n    </a>\n\n    \n    <div class=\"flex items-center gap-4 my-6\" data-kid=\"13\">\n      <div class=\"h-px flex-1 bg-white/10\" data-kid=\"14\"></div>\n      <span class=\"text-[10px] font-space font-bold tracking-widest text-white/20 uppercase\" data-kid=\"15\">Next Steps</span>\n      <div class=\"h-px flex-1 bg-white/10\" data-kid=\"16\"></div>\n    </div>\n\n    <div class=\"flex items-center justify-between\" data-kid=\"17\">\n      <a href=\"#\" class=\"flex items-center gap-2 text-sm font-semibold text-[#F3F4F6] hover:text-[#E27D60] transition-colors group\" data-kid=\"18\">\n        See how it works \n        <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"19\"></i>\n      </a>\n      \n      <div class=\"flex items-center gap-1.5 px-3 py-1.5 bg-white/5 rounded-full border border-white/5\" data-kid=\"20\">\n        <i class=\"ti ti-shield-check text-[#E27D60] text-base\" data-kid=\"21\"></i>\n        <span class=\"text-[11px] font-medium text-[#6B7280]\" data-kid=\"22\">No credit card required</span>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"mt-24 w-full max-w-[1100px] relative\" data-kid=\"23\">\n    \n    <div class=\"absolute -top-px inset-x-0 h-px bg-gradient-to-r from-transparent via-[#E27D60]/50 to-transparent z-10\" data-kid=\"24\"></div>\n    \n    <div class=\"rounded-t-3xl overflow-hidden border-t border-x border-white/10 shadow-[0_-20px_80px_rgba(226,125,96,0.08)]\" data-kid=\"25\">\n      <img src=\"/api/local/images/public/hero.png\" alt=\"Platform Preview\" class=\"w-full h-auto object-cover scale-[1.02]\" decoding=\"async\" loading=\"lazy\" data-kid=\"26\">\n    </div>\n\n    \n    <div class=\"absolute bottom-0 inset-x-0 h-64 bg-gradient-to-t from-black via-black/80 to-transparent z-20\" data-kid=\"27\"></div>\n  </div>\n</section>",
