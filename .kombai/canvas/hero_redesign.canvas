      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,700;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-sans { font-family: 'Inter', sans-serif; }\n  .font-serif { font-family: 'Playfair Display', serif; }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  .glass-card:hover {\n    background: rgba(255, 255, 255, 0.06);\n    border-color: rgba(255, 255, 255, 0.15);\n    transform: translateY(-8px);\n  }\n\n  .glow-line {\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(167, 126, 126, 0.3) 20%, rgba(250, 230, 225, 0.5) 50%, rgba(167, 126, 126, 0.3) 80%, transparent);\n    width: 100%;\n    position: absolute;\n    top: 50%;\n    left: 0;\n    z-index: 0;\n  }\n\n  .staircase-1 { transform: translateY(0); }\n  .staircase-2 { transform: translateY(40px); }\n  .staircase-3 { transform: translateY(80px); }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-10px); }\n  }\n  .animate-float {\n    animation: float 6s ease-in-out infinite;\n  }\n</style>\n\n<section class=\"relative bg-[#1A1515] text-[#F5F5F5] font-sans min-h-[900px] flex flex-col items-center justify-start py-32 overflow-hidden\" data-kid=\"1\">\n  \n  <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-[#A77E7E]/10 rounded-full blur-[120px] pointer-events-none -z-10\" data-kid=\"2\"></div>\n  \n  <div class=\"w-full max-w-7xl px-8 relative z-10\" data-kid=\"3\">\n    \n    <div class=\"mb-20\" data-kid=\"4\">\n      <h1 class=\"font-serif text-[110px] leading-[0.95] tracking-tight mb-8\" data-kid=\"5\">\n        Client Onboarding,<br data-kid=\"6\">\n        <span class=\"italic font-normal text-[#A77E7E]\" data-kid=\"7\">Elegantly</span> Solved.\n      </h1>\n      \n      <div class=\"flex flex-col md:flex-row items-end justify-between gap-12 mt-12\" data-kid=\"8\">\n        <div class=\"max-w-xl\" data-kid=\"9\">\n          <p class=\"text-xl text-white/60 leading-relaxed font-light\" data-kid=\"10\">\n            Stop losing hours to manual chaos. Send one link. Your client signs, pays, and briefs in minutes—without ever creating an account.\n          </p>\n        </div>\n        \n        <div class=\"flex items-center gap-8\" data-kid=\"11\">\n          <a href=\"#\" class=\"group relative inline-flex items-center gap-3 bg-[#FAE6E1] text-[#1A1515] px-10 py-5 rounded-full font-semibold text-lg hover:bg-white transition-all duration-300\" data-kid=\"12\">\n            Start for free\n            <i class=\"ti ti-arrow-up-right text-xl group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform\" data-kid=\"13\"></i>\n          </a>\n          <a href=\"#\" class=\"text-white/80 font-medium border-b border-white/20 pb-1 hover:text-white hover:border-white transition-all\" data-kid=\"14\">\n            Book a demo\n          </a>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"relative mt-40\" data-kid=\"15\">\n      <div class=\"glow-line\" data-kid=\"16\"></div>\n      \n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-10 relative z-10\" data-kid=\"17\">\n        \n        <div class=\"glass-card p-10 rounded-[32px] flex flex-col gap-8 staircase-1 aspect-square justify-between\" data-kid=\"18\">\n          <div class=\"flex justify-between items-start\" data-kid=\"19\">\n            <span class=\"text-xs uppercase tracking-[0.2em] text-[#A77E7E] font-semibold\" data-kid=\"20\">01 / Contract</span>\n            <div class=\"w-12 h-12 rounded-full border border-white/10 flex items-center justify-center\" data-kid=\"21\">\n              <i class=\"ti ti-file-certificate text-[#FAE6E1]\" data-kid=\"22\"></i>\n            </div>\n          </div>\n          <div class=\"flex flex-col items-center justify-center flex-grow py-4\" data-kid=\"23\">\n            <span class=\"font-serif text-[120px] text-white/5 leading-none\" data-kid=\"24\">&</span>\n            <div class=\"w-24 h-[1px] bg-white/20 mt-[-20px]\" data-kid=\"25\"></div>\n          </div>\n          <div data-kid=\"26\">\n            <h3 class=\"text-lg font-medium mb-2\" data-kid=\"27\">Instant Signing</h3>\n            <p class=\"text-sm text-white/40\" data-kid=\"28\">Legally binding, zero account needed.</p>\n          </div>\n        </div>\n\n        \n        <div class=\"glass-card p-10 rounded-[32px] flex flex-col gap-8 staircase-2 aspect-square justify-between\" data-kid=\"29\">\n          <div class=\"flex justify-between items-start\" data-kid=\"30\">\n            <span class=\"text-xs uppercase tracking-[0.2em] text-[#A77E7E] font-semibold\" data-kid=\"31\">02 / Payment</span>\n            <div class=\"w-12 h-12 rounded-full border border-white/10 flex items-center justify-center\" data-kid=\"32\">\n              <i class=\"ti ti-credit-card text-[#FAE6E1]\" data-kid=\"33\"></i>\n            </div>\n          </div>\n          <div class=\"flex items-center justify-center flex-grow\" data-kid=\"34\">\n             <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/perpendicular-rings.svg\" class=\"w-32 h-32 opacity-20 invert grayscale\" style=\"filter: drop-shadow(0 0 10px rgba(250, 230, 225, 0.3));\" decoding=\"async\" loading=\"lazy\" data-kid=\"35\">\n          </div>\n          <div data-kid=\"36\">\n            <h3 class=\"text-lg font-medium mb-2\" data-kid=\"37\">Seamless Deposits</h3>\n            <p class=\"text-sm text-white/40\" data-kid=\"38\">Collect payments directly in the flow.</p>\n          </div>\n        </div>\n\n        \n        <div class=\"glass-card p-10 rounded-[32px] flex flex-col gap-8 staircase-3 aspect-square justify-between\" data-kid=\"39\">\n          <div class=\"flex justify-between items-start\" data-kid=\"40\">\n            <span class=\"text-xs uppercase tracking-[0.2em] text-[#A77E7E] font-semibold\" data-kid=\"41\">03 / Brief</span>\n            <div class=\"w-12 h-12 rounded-full border border-white/10 flex items-center justify-center\" data-kid=\"42\">\n              <i class=\"ti ti-signature text-[#FAE6E1]\" data-kid=\"43\"></i>\n            </div>\n          </div>\n          <div class=\"flex items-center justify-center flex-grow\" data-kid=\"44\">\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/cubes.svg\" class=\"w-28 h-28 opacity-20 invert grayscale\" decoding=\"async\" loading=\"lazy\" data-kid=\"45\">\n          </div>\n          <div data-kid=\"46\">\n            <h3 class=\"text-lg font-medium mb-2\" data-kid=\"47\">Project Brief</h3>\n            <p class=\"text-sm text-white/40\" data-kid=\"48\">Gather requirements without the back-and-forth.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"absolute bottom-[-10%] right-[-5%] w-[600px] h-[600px] bg-[#A77E7E]/5 rounded-full blur-[100px] pointer-events-none\" data-kid=\"49\"></div>\n</section>",
