      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  .ticket-cutout {\n    clip-path: polygon(\n      0% 20px, 10px 20px, 10px 0%, calc(100% - 10px) 0%, calc(100% - 10px) 20px, 100% 20px,\n      100% calc(100% - 20px), calc(100% - 10px) calc(100% - 20px), calc(100% - 10px) 100%, 10px 100%, 10px calc(100% - 20px), 0% calc(100% - 20px)\n    );\n  }\n\n  .embossed-panel {\n    box-shadow: \n      inset 0 2px 5px rgba(255, 255, 255, 0.05),\n      inset 0 -2px 5px rgba(0, 0, 0, 0.5),\n      0 10px 40px rgba(0, 0, 0, 0.8);\n  }\n\n  .amber-glow {\n    filter: drop-shadow(0 0 8px rgba(217, 119, 6, 0.4));\n  }\n</style>\n\n<section class=\"relative min-h-[1000px] w-full bg-[#000000] font-sans flex flex-col items-center pt-24 overflow-hidden\" data-kid=\"1\">\n  \n  <div class=\"absolute inset-0 pointer-events-none -z-10 bg-[radial-gradient(circle_at_50%_0%,rgba(217,119,6,0.12)_0%,rgba(0,0,0,1)_70%)]\" data-kid=\"2\"></div>\n\n  \n  <div class=\"w-full max-w-6xl mx-auto px-6 flex flex-col items-center\" data-kid=\"3\">\n    \n    \n    <div class=\"relative group mb-10\" data-kid=\"4\">\n      <div class=\"absolute inset-0 bg-amber-600/20 blur-xl opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"5\"></div>\n      <div class=\"relative ticket-cutout bg-[#09090B] border border-amber-600/30 px-6 py-2 flex items-center gap-2\" data-kid=\"6\">\n        <i class=\"ti ti-sparkles text-amber-500 text-sm\" data-kid=\"7\"></i>\n        <span class=\"text-[11px] font-bold tracking-[0.15em] text-amber-500 uppercase\" data-kid=\"8\">\n          THE DUBSADO THAT TAKES 30 MINUTES TO SET UP, NOT 2 WEEKS\n        </span>\n      </div>\n    </div>\n\n    \n    <h1 class=\"text-[64px] font-bold text-white text-center leading-[1.1] tracking-tight max-w-4xl mb-6\" data-kid=\"9\">\n      Stop losing hours to client <br data-kid=\"10\"> \n      <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-600 amber-glow\" data-kid=\"11\">onboarding chaos.</span>\n    </h1>\n\n    \n    <p class=\"text-[18px] text-[#A8A29E] text-center max-w-2xl mb-16 leading-relaxed\" data-kid=\"12\">\n      Send one link. Your client signs the contract, pays the deposit, and submits their brief — without creating an account. Setup takes 30 minutes, not two weeks.\n    </p>\n\n    \n    <div class=\"relative z-30 w-full max-w-2xl -mb-12\" data-kid=\"13\">\n      <div class=\"embossed-panel bg-[#0F0F11] border border-white/5 rounded-2xl p-3 flex items-center justify-between gap-4\" data-kid=\"14\">\n        \n        <a href=\"#claim\" class=\"flex-1 bg-amber-600 hover:bg-amber-500 text-black font-bold py-4 px-8 rounded-xl flex items-center justify-center gap-2 transition-all shadow-[0_0_25px_rgba(217,119,6,0.3)] active:scale-[0.98]\" data-kid=\"15\">\n          Claim my spot\n          <i class=\"ti ti-arrow-right text-lg\" data-kid=\"16\"></i>\n        </a>\n        \n        \n        <a href=\"#how-it-works\" class=\"group flex items-center gap-2 text-[#A8A29E] hover:text-white px-6 py-4 font-semibold transition-colors\" data-kid=\"17\">\n          <span data-kid=\"18\">See how it works</span>\n          <i class=\"ti ti-arrow-down text-lg animate-bounce\" data-kid=\"19\"></i>\n          <div class=\"absolute bottom-4 right-10 w-32 h-[1px] bg-amber-600/0 group-hover:bg-amber-600/50 shadow-[0_0_8px_rgba(217,119,6,0.5)] transition-all\" data-kid=\"20\"></div>\n        </a>\n      </div>\n    </div>\n\n    \n    <div class=\"relative w-full max-w-5xl rounded-t-[32px] overflow-hidden border-t-2 border-amber-600/30 shadow-[0_-20px_50px_-20px_rgba(217,119,6,0.2)]\" data-kid=\"21\">\n      <img src=\"/api/local/images/public/hero.png\" alt=\"Platform Mockup\" class=\"w-full h-auto object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"22\">\n      \n      <div class=\"absolute inset-0 bg-gradient-to-t from-[#000000] via-transparent to-transparent pointer-events-none\" data-kid=\"23\"></div>\n    </div>\n\n  </div>\n\n  \n  <div class=\"absolute inset-0 pointer-events-none -z-20 opacity-[0.03]\" style=\"background-image: radial-gradient(#D97706 0.5px, transparent 0.5px); background-size: 24px 24px;\" data-kid=\"24\"></div>\n</section>",
